#!/bin/bash
# "command=" da chave do GitHub Actions em ~/.ssh/authorized_keys: essa chave só
# consegue dar git push no repositório do bot. Shell, scp, túnel etc. são recusados.
case "$SSH_ORIGINAL_COMMAND" in
  "git-receive-pack '/home/ubuntu/99freelas-bot'"|"git-receive-pack '99freelas-bot'")
    exec git-receive-pack /home/ubuntu/99freelas-bot ;;
  *)
    echo "comando não permitido pra esta chave" >&2
    exit 1 ;;
esac
