# Credenciais do 99Freelas — NUNCA commitar o .env real
# OPCIONAIS: o site usa Cloudflare Turnstile no login, que bloqueia login automatizado.
# O caminho recomendado é `python bot/import_cookies.py` (ver README/CLAUDE.md) pra
# reaproveitar a sessão do seu navegador comum. Se existir data/auth_state.json, estas
# duas variáveis são ignoradas.
NINETY_NINE_EMAIL=seu-email@exemplo.com
NINETY_NINE_PASSWORD=sua-senha

# false = abre o navegador visível (bom pra debugar seletores)
# true  = roda sem interface (obrigatório em servidor/cloud)
HEADLESS=true

# Intervalo entre ciclos de checagem, em segundos (min-max, escolhido aleatoriamente)
CHECK_INTERVAL_MIN_SECONDS=180
CHECK_INTERVAL_MAX_SECONDS=420

# Cota mensal de propostas (conexões do plano). O bot divide esse valor pelos dias do
# mês corrente automaticamente e nunca ultrapassa o resultado num único dia.
MONTHLY_PROPOSAL_QUOTA=240

# Necessárias só conforme o proposal.ia_provider escolhido no config.yaml
# (proposal.texto_modo == "ia"). ANTHROPIC_API_KEY: https://console.anthropic.com/
# GEMINI_API_KEY (tier gratuito): https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Notificação via Telegram de cada tentativa de envio de proposta (sucesso ou falha) E
# de mudanças de estado do bot (online, parado, erro fatal, autenticação falhou, ciclo
# com problema/recuperado — ver notifier.notify_bot_status). Rodando normal, sem nenhum
# problema, não gera mensagem nenhuma — só nas transições de estado.
# Opcional: sem essas duas variáveis, o bot só loga (não notifica).
# 1. Fale com @BotFather no Telegram, /newbot, pegue o token gerado.
# 2. Fale com o bot que você criou (qualquer mensagem), depois abra
#    https://api.telegram.org/bot<SEU_TOKEN>/getUpdates e pegue "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# De quanto em quanto tempo (segundos) o bot checa se você respondeu Aprovar/Rejeitar no
# Telegram — bem mais curto que CHECK_INTERVAL_*, pra não atrasar o envio de projetos
# sensíveis a velocidade depois que você já aprovou. Não precisa de nenhuma variável nova
# além de TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID já configuradas acima.
APPROVAL_POLL_INTERVAL_SECONDS=20

# De quanto em quanto tempo (segundos) o bot checa o badge de mensagens não lidas no
# header do site (bot/messages.py) e avisa via Telegram quando o contador aumenta — a
# notificação nativa do 99Freelas costuma atrasar/falhar. Cada checagem navega até
# /dashboard, por isso um valor mais espaçado que APPROVAL_POLL_INTERVAL_SECONDS.
MESSAGES_POLL_INTERVAL_SECONDS=60

# Log de atividade do bot (ciclos, ignorados, decisões) via Telegram. false desliga.
ACTIVITY_LOG_TELEGRAM=true

# Opcional — botões Aprovar/Refazer/Reprovar do `python bot/portfolio.py`. Precisa ser um
# SEGUNDO bot (@BotFather → /newbot), diferente do TELEGRAM_BOT_TOKEN: dois processos não
# podem ler os cliques do mesmo bot. Mande qualquer mensagem pra ele uma vez (pra poder
# escrever no seu chat); o chat é o mesmo TELEGRAM_CHAT_ID. Sem isso, o comando funciona
# sem botões.
PORTFOLIO_TELEGRAM_BOT_TOKEN=
